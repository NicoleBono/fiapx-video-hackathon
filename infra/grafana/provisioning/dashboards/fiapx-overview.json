{
  "title": "FIAP X - Visão Geral",
  "uid": "fiapx-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "tags": ["fiapx"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests/s (auth + video)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Vídeos: uploads e downloads / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(videos_uploaded_total[1m]) * 60",
          "legendFormat": "uploads/min"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(video_downloads_total[1m]) * 60",
          "legendFormat": "downloads/min"
        }
      ]
    },
    {
      "id": 4,
      "title": "Eventos de status de vídeo consumidos",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(video_status_events_total[1m])) by (routing_key)",
          "legendFormat": "{{routing_key}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Jobs de processamento (ffmpeg) por resultado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(processing_jobs_total[1m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Notificações de falha enviadas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(notifications_sent_total[1m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "RabbitMQ - mensagens prontas por fila",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "RabbitMQ - consumidores por fila",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rabbitmq_queue_consumers",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Memória residente por serviço (Node.js)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
